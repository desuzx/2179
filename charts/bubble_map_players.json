  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 430,
  "background": "#f4ebd0",
  "params": [
    {
      "name": "zoom_level",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 800,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        0,
        20
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            0,
            20
          ],
          [
            15,
            50
          ],
          [
            100,
            35
          ],
          [
            -95,
            40
          ],
          [
            135,
            -25
          ]
        ],
        "labels": [
          "World",
          "Europe",
          "Asia",
          "North America",
          "Australia"
        ],
        "name": "Focus: "
      }
    }
  ],
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "zoom_level"
    },
    "center": {
      "expr": "center_to"
    }
  },

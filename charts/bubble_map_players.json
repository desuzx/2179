                "title": "Region"
              },
              {
                "field": "Count",
                "title": "Top-100 Players"
              },
              {
                "field": "TopGame",
                "title": "Top Game(s)"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.Region === 'Oceania'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 14,
            "dy": 2,
            "fontSize": 11,
            "fontWeight": 600,
            "font": "Space Grotesk"
          },
          "encoding": {
            "longitude": {
              "field": "Lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "Lat",
              "type": "quantitative"
            },
            "text": {
              "value": "Australia"
            },

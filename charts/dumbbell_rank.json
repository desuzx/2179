{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 540,
  "background": "#f4ebd0",
  "padding": {
    "left": 16,
    "right": 16,
    "top": 28,
    "bottom": 16
  },
  "data": {
    "url": "data/esports_countries_percapita.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Rank)",
      "as": "Rank"
    },
    {
      "calculate": "toNumber(datum.PerCapitaRank)",
      "as": "PerCapitaRank"
    },
    {
      "filter": "datum.Rank <= 20"
    },
    {
      "calculate": "datum.Rank - datum.PerCapitaRank",
      "as": "Shift"
    },
    {
      "calculate": "datum.Shift > 0 ? 'improved' : 'declined'",
      "as": "Direction"
    },
    {
      "calculate": "datum.Shift > 0 ? '▲ +' + datum.Shift : '▼ ' + datum.Shift",
      "as": "ShiftLabel"
    },
    {
      "calculate": "datum.Country == 'Australia'",
      "as": "IsAustralia"
    }
  ],
  "encoding": {
    "y": {
      "field": "Country",
      "type": "nominal",
      "sort": {
        "field": "Shift",
        "order": "descending"
      },
      "axis": {
        "labelColor": "#1a1410",
        "labelFontSize": 12,
        "labelFont": "Space Grotesk",
        "labelFontWeight": 500,
        "title": null,
        "ticks": false,
        "domain": false,
        "labelPadding": 14
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.IsAustralia"
        }
      ],
      "mark": {
        "type": "bar",
        "color": "#e0457b",
        "opacity": 0.08,
        "height": 22
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "datum": 82
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3.5,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "Rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              82
            ]
          },
          "axis": {
            "title": "Global Rank (1 = best)",
            "titleColor": "#5a4d3a",
            "titleFont": "Space Grotesk",
            "titleFontSize": 11,
            "titlePadding": 12,
            "labelColor": "#3a3026",
            "labelFont": "Space Grotesk",
            "labelFontSize": 11,
            "ticks": false,
            "domainColor": "#a89568",
            "gridColor": "#c9b88a",
            "gridDash": [
              3,
              3
            ],
            "values": [
              1,
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "x2": {
          "field": "PerCapitaRank"
        },
        "color": {
          "field": "Direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "improved",
              "declined"
            ],
            "range": [
              "#5fa752",
              "#e0457b"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "highlightCountry === '' || datum.Country === highlightCountry",
            "value": 1
          },
          "value": 0.18
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 200,
        "opacity": 0.95,
        "stroke": "#f4ebd0",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Rank",
          "type": "quantitative"
        },
        "color": {
          "value": "#e8a838"
        },
        "tooltip": [
          {
            "field": "Country",
            "title": "Country"
          },
          {
            "field": "Rank",
            "title": "Total Earnings Rank"
          },
          {
            "field": "PerCapitaRank",
            "title": "Per Capita Rank"
          },
          {
            "field": "ShiftLabel",
            "title": "Shift"
          }
        ],
        "opacity": {
          "condition": {
            "test": "highlightCountry === '' || datum.Country === highlightCountry",
            "value": 1
          },
          "value": 0.18
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 260,
        "opacity": 1,
        "stroke": "#f4ebd0",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "PerCapitaRank",
          "type": "quantitative"
        },
        "color": {
          "field": "Direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "improved",
              "declined"
            ],
            "range": [
              "#5fa752",
              "#e0457b"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Country",
            "title": "Country"
          },
          {
            "field": "Rank",
            "title": "Total Earnings Rank"
          },
          {
            "field": "PerCapitaRank",
            "title": "Per Capita Rank"
          },
          {
            "field": "ShiftLabel",
            "title": "Shift"
          }
        ],
        "opacity": {
          "condition": {
            "test": "highlightCountry === '' || datum.Country === highlightCountry",
            "value": 1
          },
          "value": 0.18
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 13,
        "fontWeight": 700,
        "font": "Space Grotesk"
      },
      "encoding": {
        "x": {
          "datum": 76
        },
        "text": {
          "field": "ShiftLabel"
        },
        "color": {
          "field": "Direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "improved",
              "declined"
            ],
            "range": [
              "#5fa752",
              "#e0457b"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "highlightCountry === '' || datum.Country === highlightCountry",
            "value": 1
          },
          "value": 0.18
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "params": [
    {
      "name": "highlightCountry",
      "value": ""
    }
  ]
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "naturalEarth1"
  },
  "background": "#f4ebd0",
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#c9b88a",
        "stroke": "#a89568",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/esports_countries_percapita.csv"
            },
            "key": "id",
            "fields": [
              "Country",
              "PrizePerMillion"
            ]
          }
        },
        {
          "filter": "datum.PrizePerMillion == null"
        },
        {
          "calculate": "'No data available'",
          "as": "NoDataMsg"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0
      },
      "encoding": {
        "color": {
          "value": "transparent"
        },
        "tooltip": {
          "field": "NoDataMsg",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/esports_countries_percapita.csv"
            },
            "key": "id",
            "fields": [
              "Country",
              "TotalPrize",
              "NumPlayers",
              "Population",
              "PrizePerMillion",
              "PlayersPerMillion",
              "TopGame",
              "TopGamePct",
              "Rank",
              "PerCapitaRank"
            ]
          }
        },
        {
          "filter": "datum.PrizePerMillion != null"
        }
      ],
      "params": [
        {
          "name": "hover2",
          "select": {
            "type": "point",
            "on": "mouseover"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "PrizePerMillion",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "range": [
              "#f1c14b",
              "#e8853a",
              "#d94545",
              "#e0457b",
              "#a04578",
              "#6e4ba0",
              "#3a2a5c"
            ],
            "domainMin": 1
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "param": "hover2",
            "empty": false,
            "value": "#6e4ba0"
          },
          "value": "#a89568"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover2",
            "empty": false,
            "value": 1.5
          },
          "value": 0.4
        },
        "opacity": {
          "condition": [
            {
              "param": "hover2",
              "empty": false,
              "value": 1
            },
            {
              "test": "highlightCountry === '' || datum.Country === highlightCountry",
              "value": 0.9
            }
          ],
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "PerCapitaRank",
            "title": "Per Capita Rank"
          },
          {
            "field": "Rank",
            "title": "Total Earnings Rank"
          },
          {
            "field": "Country",
            "title": "Country"
          },
          {
            "field": "PrizePerMillion",
            "title": "Prize per Million People",
            "format": "$,.0f"
          },
          {
            "field": "TotalPrize",
            "title": "Total Prize Money",
            "format": "$,.0f"
          },
          {
            "field": "Population",
            "title": "Population",
            "format": ","
          },
          {
            "field": "TopGame",
            "title": "Top Game"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "params": [
    {
      "name": "highlightCountry",
      "value": ""
    }
  ]
}
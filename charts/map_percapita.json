{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 680,
  "height": 380,
  "projection": { "type": "naturalEarth1" },
  "background": "#161428",
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#1e1a30",
        "stroke": "#2a2444",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": { "url": "data/esports_countries_percapita.csv" },
            "key": "id",
            "fields": [
              "Country",
              "TotalPrize",
              "NumPlayers",
              "Population",
              "PrizePerMillion",
              "PlayersPerMillion",
              "TopGame",
              "TopGamePct",
              "Rank",
              "PerCapitaRank"
            ]
          }
        },
        { "filter": "datum.PrizePerMillion != null" }
      ],
      "params": [
        {
          "name": "hover2",
          "select": { "type": "point", "on": "mouseover" }
        }
      ],
      "mark": { "type": "geoshape", "strokeWidth": 0.4 },
      "encoding": {
        "color": {
          "field": "PrizePerMillion",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "range": [
              "#1e1a38",
              "#2e2860",
              "#4a40a0",
              "#534ab7",
              "#7f77dd",
              "#afa9ec",
              "#ee3e75"
            ],
            "domainMin": 1
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "param": "hover2",
            "empty": false,
            "value": "#afa9ec"
          },
          "value": "#2a2444"
        },
        "strokeWidth": {
          "condition": { "param": "hover2", "empty": false, "value": 1.5 },
          "value": 0.4
        },
        "opacity": {
          "condition": { "param": "hover2", "empty": false, "value": 1 },
          "value": 0.85
        },
        "tooltip": [
          { "field": "PerCapitaRank", "title": "Per Capita Rank" },
          { "field": "Rank", "title": "Total Earnings Rank" },
          { "field": "Country", "title": "Country" },
          {
            "field": "PrizePerMillion",
            "title": "Prize per Million People",
            "format": "$,.0f"
          },

          {
            "field": "TotalPrize",
            "title": "Total Prize Money",
            "format": "$,.0f"
          },
          { "field": "Population", "title": "Population", "format": "," },
          { "field": "TopGame", "title": "Top Game" }
        ]
      }
    }
  ],
  "config": { "view": { "stroke": "transparent" } }
}

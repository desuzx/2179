{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "naturalEarth1"
  },
  "background": "#f4ebd0",
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#c9b88a",
        "stroke": "#a89568",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/esports_countries_cleaned.csv"
            },
            "key": "id",
            "fields": [
              "Country",
              "TotalPrize"
            ]
          }
        },
        {
          "filter": "datum.TotalPrize == null"
        },
        {
          "calculate": "'No data available'",
          "as": "NoDataMsg"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0
      },
      "encoding": {
        "color": {
          "value": "transparent"
        },
        "tooltip": {
          "field": "NoDataMsg",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/esports_countries_cleaned.csv"
            },
            "key": "id",
            "fields": [
              "Country",
              "TotalPrize",
              "NumPlayers",
              "TopGame",
              "TopGameEarnings",
              "TopGamePct",
              "Rank"
            ]
          }
        },
        {
          "filter": "datum.TotalPrize != null"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "TotalPrize",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "range": [
              "#f1c14b",
              "#e8853a",
              "#d94545",
              "#e0457b",
              "#a04578",
              "#6e4ba0",
              "#3a2a5c"
            ],
            "domainMin": 100
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#6e4ba0"
          },
          "value": "#a89568"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1.5
          },
          "value": 0.4
        },
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            {
              "test": "highlightCountry === '' || datum.Country === highlightCountry",
              "value": 0.9
            }
          ],
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "Rank",
            "title": "Rank"
          },
          {
            "field": "Country",
            "title": "Country"
          },
          {
            "field": "TotalPrize",
            "title": "Total Prize Money",
            "format": "$,.0f"
          },
          {
            "field": "NumPlayers",
            "title": "Players Who Won Money",
            "format": ","
          },
          {
            "field": "TopGame",
            "title": "Top Game"
          },
          {
            "field": "TopGameEarnings",
            "title": "Top Game Earnings",
            "format": "$,.0f"
          },
          {
            "field": "TopGamePct",
            "title": "% From Top Game",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "params": [
    {
      "name": "highlightCountry",
      "value": ""
    }
  ]
}
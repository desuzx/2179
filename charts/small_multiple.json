{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#f4ebd0",
  "data": {
    "url": "data/genre_yearly.csv"
  },
  "facet": {
    "field": "Genre",
    "type": "nominal",
    "columns": 3,
    "sort": [
      "Multiplayer Online Battle Arena",
      "First-Person Shooter",
      "Battle Royale",
      "Strategy",
      "Sports"
    ],
    "header": {
      "labelColor": "#1a1410",
      "labelFontSize": 13,
      "labelFont": "Space Grotesk",
      "labelFontWeight": 600,
      "title": null,
      "labelPadding": 10
    }
  },
  "spec": {
    "width": 132,
    "height": 130,
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "opacity": 0.2
        },
        "encoding": {
          "x": {
            "field": "Year",
            "type": "quantitative",
            "axis": {
              "labelColor": "#3a3026",
              "labelFontSize": 9,
              "labelFont": "Space Grotesk",
              "format": "d",
              "ticks": false,
              "domainColor": "#a89568",
              "grid": false,
              "title": null,
              "labelAngle": 0,
              "tickCount": 3
            },
            "scale": {
              "domainMax": 2024,
              "domainMin": 1998
            }
          },
          "y": {
            "field": "TotalEarnings",
            "type": "quantitative",
            "axis": {
              "labelColor": "#3a3026",
              "labelFontSize": 9,
              "labelFont": "Space Grotesk",
              "format": "$~s",
              "ticks": false,
              "domainColor": "#a89568",
              "gridColor": "#c9b88a",
              "gridDash": [
                3,
                3
              ],
              "title": null,
              "tickCount": 3
            }
          },
          "color": {
            "field": "Genre",
            "type": "nominal",
            "scale": {
              "domain": [
                "Multiplayer Online Battle Arena",
                "First-Person Shooter",
                "Battle Royale",
                "Strategy",
                "Sports"
              ],
              "range": [
                "#e0457b",
                "#3a76b8",
                "#a065c4",
                "#e8853a",
                "#5fa752"
              ]
            },
            "legend": null
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "strokeWidth": 2
        },
        "encoding": {
          "x": {
            "field": "Year",
            "type": "quantitative"
          },
          "y": {
            "field": "TotalEarnings",
            "type": "quantitative"
          },
          "color": {
            "field": "Genre",
            "type": "nominal",
            "scale": {
              "domain": [
                "Multiplayer Online Battle Arena",
                "First-Person Shooter",
                "Battle Royale",
                "Strategy",
                "Sports"
              ],
              "range": [
                "#e0457b",
                "#3a76b8",
                "#a065c4",
                "#e8853a",
                "#5fa752"
              ]
            },
            "legend": null
          }
        }
      },
      {
        "params": [
          {
            "name": "hoverGenre",
            "select": {
              "type": "point",
              "fields": [
                "Year"
              ],
              "nearest": true,
              "on": "mousemove",
              "clear": "mouseout"
            }
          }
        ],
        "mark": {
          "type": "point",
          "opacity": 0
        },
        "encoding": {
          "x": {
            "field": "Year",
            "type": "quantitative"
          },
          "y": {
            "field": "TotalEarnings",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 60
        },
        "encoding": {
          "x": {
            "field": "Year",
            "type": "quantitative"
          },
          "y": {
            "field": "TotalEarnings",
            "type": "quantitative"
          },
          "color": {
            "field": "Genre",
            "type": "nominal",
            "scale": {
              "domain": [
                "Multiplayer Online Battle Arena",
                "First-Person Shooter",
                "Battle Royale",
                "Strategy",
                "Sports"
              ],
              "range": [
                "#e0457b",
                "#3a76b8",
                "#a065c4",
                "#e8853a",
                "#5fa752"
              ]
            },
            "legend": null
          },
          "opacity": {
            "condition": {
              "param": "hoverGenre",
              "empty": false,
              "value": 1
            },
            "value": 0
          },
          "tooltip": [
            {
              "field": "Year",
              "title": "Year",
              "format": "d"
            },
            {
              "field": "Genre",
              "title": "Genre"
            },
            {
              "field": "TotalEarnings",
              "title": "Prize Money",
              "format": "$,.0f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spacing": 20,
  "config": {
    "view": {
      "stroke": "#c9b88a",
      "strokeWidth": 1,
      "fill": "#f4ebd0"
    },
    "background": "#f4ebd0"
  }
}
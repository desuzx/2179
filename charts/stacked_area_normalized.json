{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 300,
  "background": "#f4ebd0",
  "data": {
    "url": "data/genre_yearly.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "Genre",
        "oneOf": [
          "Multiplayer Online Battle Arena",
          "Battle Royale",
          "First-Person Shooter",
          "Strategy",
          "Sports"
        ]
      }
    },
    {
      "filter": "datum.Year <= 2023"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "TotalEarnings",
          "as": "YearTotal"
        }
      ],
      "groupby": [
        "Year"
      ]
    },
    {
      "calculate": "round(datum.TotalEarnings / datum.YearTotal * 1000) / 10",
      "as": "SharePct"
    }
  ],
  "mark": {
    "type": "area",
    "line": false,
    "opacity": 0.88
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {
        "domain": [
          1998,
          2023
        ]
      },
      "axis": {
        "labelColor": "#3a3026",
        "labelFontSize": 11,
        "labelFont": "Space Grotesk",
        "format": "d",
        "ticks": false,
        "domainColor": "#a89568",
        "gridColor": "#c9b88a",
        "gridDash": [
          3,
          3
        ],
        "title": null
      }
    },
    "y": {
      "field": "TotalEarnings",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {
        "labelColor": "#3a3026",
        "labelFontSize": 11,
        "labelFont": "Space Grotesk",
        "format": "%",
        "ticks": false,
        "domainColor": "#a89568",
        "gridColor": "#c9b88a",
        "gridDash": [
          3,
          3
        ],
        "title": "Share of Annual Prize Money",
        "titleColor": "#5a4d3a",
        "titleFontSize": 11,
        "titleFont": "Space Grotesk",
        "titlePadding": 10
      }
    },
    "color": {
      "field": "Genre",
      "type": "nominal",
      "scale": {
        "domain": [
          "Multiplayer Online Battle Arena",
          "First-Person Shooter",
          "Battle Royale",
          "Strategy",
          "Sports"
        ],
        "range": [
          "#e0457b",
          "#3a76b8",
          "#a065c4",
          "#e8853a",
          "#5fa752"
        ]
      },
      "legend": {
        "title": "Genre",
        "titleColor": "#5a4d3a",
        "titleFontSize": 10,
        "titleFont": "Space Grotesk",
        "labelColor": "#3a3026",
        "labelFontSize": 10,
        "labelFont": "Space Grotesk",
        "labelLimit": 220,
        "orient": "right",
        "symbolSize": 60,
        "rowPadding": 2
      }
    },
    "order": {
      "field": "Genre",
      "type": "nominal",
      "sort": [
        "Multiplayer Online Battle Arena",
        "Battle Royale",
        "First-Person Shooter",
        "Strategy",
        "Sports"
      ]
    },
    "tooltip": [
      {
        "field": "Year",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "Genre",
        "title": "Genre"
      },
      {
        "field": "TotalEarnings",
        "title": "Prize Money",
        "format": "$,.0f"
      },
      {
        "field": "SharePct",
        "title": "Share of Year %",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
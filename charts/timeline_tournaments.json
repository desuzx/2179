      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5
      },
      "encoding": {
        "y2": {
          "datum": 0
        },
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            {
              "param": "hover",
              "empty": true,
              "value": 0.6
            }
          ],
          "value": 0.15
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "nearest": true
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#f4ebd0",
        "strokeWidth": 1.5
      },
      "encoding": {
        "size": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 220
          },
          "value": 80,
          "legend": null
        },
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            {
              "param": "hover",
              "empty": true,
              "value": 0.85
            }
          ],
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "Rank",
            "title": "Overall Rank"
          },
          {
            "field": "Tournament",
            "title": "Tournament"
          },
          {
            "field": "Game",
            "title": "Game"
          },
          {
            "field": "PrizePool",
            "title": "Prize Pool",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Rank == 1"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Space Grotesk",
        "fontSize": 11,
        "fontWeight": 600,
        "dy": -16,
        "align": "center"
      },
      "encoding": {
        "text": {
          "value": "$40M record"
        },
        "color": {
          "value": "#e0457b"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.AusMilestone != ''"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Space Grotesk",
        "fontSize": 11,
        "fontWeight": 600,
        "dy": -16,
        "dx": 6,
        "align": "left"
      },
      "encoding": {
        "text": {
          "field": "AusMilestone"
        },
        "color": {
          "value": "#e0457b"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
